{
  "name": "parsons",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "python3 tools/pipeline/build.py",
    "dev": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "node tools/verify/check-assembler.mjs && python3 tools/verify/run-assembled.py",
    "db:up": "docker compose up -d",
    "db:push": "pnpm --filter api push",
    "db:seed": "pnpm --filter api seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
